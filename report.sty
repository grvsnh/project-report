% Custom contents rows resolve their numbers, titles and page ranges from labels.
% Contents and list entries name only the page on which an item starts; the
% closing label is still accepted so existing rows need no second edit.
\newcommand{\PageRange}[2]{\pageref{#1}}
% Chapter-level part headings such as PUBLICATION DETAILS and REFERENCES are
% centered at 18pt, the same size as the chapter title block.
\newcommand{\PartHeading}[1]{%
  \par\addvspace{6pt}%
  {\centering\fontsize{18pt}{22pt}\selectfont\bfseries #1\par}%
  \addvspace{10pt}}
% Evidence images are captioned with the same snapshot number that the List of
% Snaps reports, so the page and the list can be matched by eye.
\newcommand{\SnapCaption}[2]{%
  \par\vspace{6pt}\begin{center}Snap #1\quad #2\end{center}%
}
\newcommand{\ContentsTitleX}{156.14}
\newcommand{\ContentsNumberX}{117.86}
\newcommand{\ContentsRow}[3]{%
  \FrontLineRaw{\ContentsTitleX}{\ContentsY{#1}}{0}{12}{\ref{#2}\ \nameref{#2}}%
  \FrontLineRaw{456.34}{\ContentsY{#1}}{30}{12}{\hfill\PageRange{#2}{#3}\hfill}%
}
\newcommand{\ContentsChapter}[3]{%
  \FrontLineRaw{\ContentsNumberX}{\ContentsY{#1}}{0}{12}{\textbf{\ref{#2}}}%
  \FrontLineRaw{\ContentsTitleX}{\ContentsY{#1}}{0}{12}{\textbf{\nameref{#2}}}%
  \FrontLineRaw{456.34}{\ContentsY{#1}}{30}{12}{\hfill\textbf{\PageRange{#2}{#3}}\hfill}%
}
% Surveyed-paper titles run to two or three lines, so their contents rows are
% set as one flowing block: LaTeX spaces the entries itself and no hand-tuned
% row height can be overrun.  The page-number box is a zero-width overlay at
% the right of the row's first line, so wrapped continuation lines and the page
% column can never meet.
\newcommand{\ContentsFlowPage}[2]{%
  \rlap{\hspace*{300.20bp}\makebox[30bp][c]{\PageRange{#1}{#2}}}}
% Section rows start in the same column as every other chapter's sections and
% wrap under the title; chapter rows pull the number back into the chapter
% column, so both line up with the rest of the contents.  The hanging indent is
% the width of the number and its space, so a second line begins directly under
% the first word of the title rather than an extra indent to its right.
\newsavebox{\contentshangbox}
\newcommand{\ContentsFlowRow}[2]{%
  \par\noindent\ContentsFlowPage{#1}{#2}%
  \sbox{\contentshangbox}{\ref{#1}\ }%
  \hangindent=\wd\contentshangbox \hangafter=1
  \ref{#1}\ \nameref{#1}\par}
\newcommand{\ContentsFlowChapter}[2]{%
  \par\noindent
  \rlap{\hspace*{300.20bp}\makebox[30bp][c]{\textbf{\PageRange{#1}{#2}}}}%
  \hspace*{-38.28bp}\makebox[38.28bp][l]{\textbf{\ref{#1}}}%
  \textbf{\nameref{#1}}\par}
\newcommand{\ContentsFlowBlock}[2]{%
  \node[anchor=base west,inner sep=0pt,outer sep=0pt]
    at ($(current page.north west)+(\ContentsTitleX bp,-\ContentsY{#1}bp)$)
    {\begin{minipage}[t]{286bp}%
      \setstretch{1}\fontsize{12bp}{15bp}\selectfont\raggedright
      \setlength{\parindent}{0pt}\setlength{\parskip}{8.85bp}%
      \setlength{\parfillskip}{0pt plus 1fil}%
      #2%
    \end{minipage}};%
}

